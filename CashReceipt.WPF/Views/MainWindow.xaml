<Window x:Class="CashReceipt.WPF.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CashReceipt.WPF.ViewModels"
        Title="Cash Receipt - Modern" Height="600" Width="900"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border Background="#FF1F2937" Grid.Column="0">
            <StackPanel Margin="10">
                <TextBlock Text="CashReceipt" Foreground="White" FontSize="20" FontWeight="Bold" Margin="0,10" />
                <Button Content="Dashboard" Margin="0,8" Click="Nav_Dashboard" Style="{StaticResource MaterialDesignFlatButton}" />
                <Button Content="Patients" Margin="0,8" Click="Nav_Patients" Style="{StaticResource MaterialDesignFlatButton}" />
                <Button Content="IPD" Margin="0,8" Style="{StaticResource MaterialDesignFlatButton}" />
                <Button Content="Reports" Margin="0,8" Style="{StaticResource MaterialDesignFlatButton}" />
                <Button Content="Settings" Margin="0,8" Style="{StaticResource MaterialDesignFlatButton}" />
            </StackPanel>
        </Border>
        <Grid Grid.Column="1" Background="#FFF3F4F6">
            <StackPanel Margin="20">
                <TextBlock Text="Welcome to modernized CashReceipt" FontSize="18" FontWeight="SemiBold" />
                <Border Background="White" CornerRadius="8" Padding="16" Margin="0,12">
                    <StackPanel>
                        <TextBlock Text="Recent Patients" FontWeight="Bold" />
                        <ListView Height="300" ItemsSource="{Binding RecentPatients}" />
                    </StackPanel>
                </Border>
            </StackPanel>
            <ContentControl x:Name="ContentHost" Grid.Row="1" />
        </Grid>
    </Grid>
</Window>