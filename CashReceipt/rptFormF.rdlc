                      <TextDecoration>None</TextDecoration>
                      <Color>#000000</Color>
                    </Style>
                  </TextRun>
                  <TextRun>
                    <Value> Evaluation of umbilical cord – presentation, insertion, nuchal encirclement, number of vessels and presence of true knot.</Value>
                    <Style>
                      <FontStyle>Normal</FontStyle>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>7pt</FontSize>
